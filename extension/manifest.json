{
  "manifest_version": 3,
  "name": "XVC — X Video Copy",
  "version": "0.2.1",
  "description": "在 X 视频上右键复制 MP4，自定义大小上限与缓存位置。需要 XVC macOS 本地程序。",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": ["nativeMessaging"],
  "background": {"service_worker": "service-worker.js", "type": "module"},
  "action": {"default_popup": "popup.html", "default_title": "XVC · X Video Copy", "default_icon": {"16": "icons/16.png", "32": "icons/32.png"}},
  "options_ui": {"page": "popup.html", "open_in_tab": true},
  "content_scripts": [
    {"matches": ["https://x.com/*", "https://twitter.com/*"], "js": ["page-main.js"], "run_at": "document_start", "world": "MAIN"},
    {"matches": ["https://x.com/*", "https://twitter.com/*"], "js": ["content-bundle.js"], "run_at": "document_start", "world": "ISOLATED"}
  ],
  "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}
}
